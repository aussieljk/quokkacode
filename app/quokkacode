#!/usr/bin/env bash
set -euo pipefail

# This launcher is normally reached through ~/.local/bin/quokkacode.
# Resolve the symlink so subcommands still find the scripts next to it.
# THREADBARE_* was the old name for these variables: each stands in for its new name.
for v in $(compgen -e | grep '^THREADBARE_' || true); do n="QUOKKACODE_${v#THREADBARE_}"; [ -n "${!n+x}" ] || export "$n=${!v}"; done
SCRIPT_DIR="$(python3 -c 'import os,sys; print(os.path.dirname(os.path.realpath(sys.argv[1])))' "${BASH_SOURCE[0]}")"
APP_DIR="${QUOKKACODE_APP_DIR:-$HOME/Applications/QuokkaCode.app}"

case "${1:-start}" in
  start)
    if [[ ! -d "$APP_DIR" ]]; then
      bash "$SCRIPT_DIR/setup_mac.sh"
    fi
    open "$APP_DIR"
    ;;
  restart)
    exec bash "$SCRIPT_DIR/restart.sh"
    ;;
  setup)
    # Sets Quokka Code up from a clone (scripts/setup.mjs): your own Convex
    # project, keys, the runner and the app. Safe to run again.
    shift
    if ! command -v node >/dev/null 2>&1 || [[ "$(node -p 'process.versions.node.split(".")[0]')" -lt 24 ]]; then
      echo "Quokka Code needs Node 24 or newer: https://nodejs.org (or nvm install 24), then run this again." >&2
      exit 1
    fi
    exec node "$SCRIPT_DIR/../scripts/setup.mjs" "$@"
    ;;
  mock)
    # Opens the app against the mock runner with a temp data folder.
    shift
    exec bash "$SCRIPT_DIR/Tools/run-mock.sh" "$@"
    ;;
  perf)
    shift
    exec bash "$SCRIPT_DIR/Tools/perf-run.sh" "$@"
    ;;
  stop|kill)
    exec bash "$SCRIPT_DIR/kill.sh"
    ;;
  setup|install)
    exec bash "$SCRIPT_DIR/setup_mac.sh"
    ;;
  *)
    echo "Usage: quokkacode [start|restart|mock|perf|stop|setup]" >&2
    exit 2
    ;;
esac
